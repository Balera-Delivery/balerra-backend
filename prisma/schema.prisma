datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  RIDER
  ADMIN
}

enum AccountStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

enum RiderAvailability {
  ONLINE
  OFFLINE
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  ARRIVED_AT_PICKUP
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  ON_THE_WAY
  DELIVERED
  COMPLETED
  CANCELLED
}

model Customer {
  id            String         @id @default(uuid())
  fullName      String
  phoneNumber   String         @unique
  email         String?        @unique
  password      String
  address       String?
  status        AccountStatus  @default(ACTIVE)
  fcmToken      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deliveries    Delivery[]
  orders        Order[]
  notifications Notification[]

  @@map("customers")
}

model Rider {
  id                 String             @id @default(uuid())
  fullName           String
  email              String?            @unique
  phoneNumber        String             @unique
  password           String
  availabilityStatus RiderAvailability  @default(OFFLINE)
  accountStatus      AccountStatus      @default(PENDING_APPROVAL)
  isPhoneVerified    Boolean            @default(false)
  isDeactivated      Boolean            @default(false)
  isDeleted          Boolean            @default(false)
  vehicleInfo        String?
  currentLatitude    Float?
  currentLongitude   Float?
  heading            Float?
  lastLocationUpdate DateTime?
  fcmToken           String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deliveries         Delivery[]
  notifications      Notification[]

  @@map("riders")
}

model Admin {
  id            String         @id @default(uuid())
  fullName      String
  email         String         @unique
  password      String
  role          String         @default("ADMIN") // SUPER_ADMIN, ADMIN
  fcmToken      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]

  @@map("admins")
}

model Restaurant {
  id           String     @id @default(uuid())
  code         String?    @unique // e.g. HTL-001
  name         String
  aliases      String[]   @default([])
  category     String     @default("Cafe & Restaurant")
  cuisineType  String     @default("Local & Traditional Cuisine")
  phone1       String     @default("")
  phone2       String     @default("")
  address      String     @default("Bale Robe, Ethiopia")
  latitude     Float?
  longitude    Float?
  rating       Float      @default(4.8)
  totalReviews Int        @default(0)
  deliveryTime String     @default("25 - 40 min")
  deliveryFee  Float      @default(60.0)
  priceRange   String     @default("$$")
  status       String     @default("Active") // Active, Inactive
  openingHours String     @default("07:00 AM - 10:00 PM")
  isPartner    Boolean    @default(true)
  banner       String?    @db.Text
  avatar       String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  foods        FoodItem[]
  orders       Order[]
  promotions   Promotion[]

  @@map("restaurants")
}

model FoodItem {
  id           String      @id @default(uuid())
  code         String?     // e.g. FOOD-001-1
  restaurantId String
  name         String
  category     String      @default("Main Dishes")
  price        Float
  description  String?     @db.Text
  isAvailable  Boolean     @default(true)
  tag          String?     @default("") // Popular, House Special, Spicy, Fast Selling
  image        String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@map("food_items")
}

model Order {
  id                  String      @id @default(uuid())
  orderNumber         String      @unique // e.g. ORD-2026-0001
  customerId          String
  restaurantId        String
  deliveryId          String?     @unique
  subtotal            Float
  deliveryFee         Float       @default(60.0)
  totalAmount         Float
  status              OrderStatus @default(PENDING)
  paymentMethod       String      @default("CASH_ON_DELIVERY")
  paymentStatus       String      @default("PENDING")
  receiptUrl          String?     @db.Text
  specialInstructions String?     @db.Text
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  customer            Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurant          Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  delivery            Delivery?   @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  items               OrderItem[]

  @@map("orders")
}

model OrderItem {
  id         String    @id @default(uuid())
  orderId    String
  foodItemId String?
  name       String
  price      Float
  quantity   Int       @default(1)
  subtotal   Float
  notes      String?

  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodItem   FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model Delivery {
  id                  String               @id @default(uuid())
  trackingCode        String               @unique
  qrCodeToken         String?              @unique
  customerId          String
  riderId             String?
  pickupLocation      String
  pickupLatitude      Float?
  pickupLongitude     Float?
  destination         String
  destinationLatitude Float?
  destinationLongitude Float?
  itemType            String
  itemDescription     String
  receiverName        String
  receiverPhone       String
  specialInstructions String?
  paymentMethod       String               @default("CASH_ON_DELIVERY")
  paymentStatus       String               @default("PENDING")
  receiptUrl          String?              @db.Text
  status              DeliveryStatus       @default(PENDING)
  cancellationReason  String?
  riderFee            Float?               @default(50.0)
  isPaidToRider       Boolean              @default(false)
  riderPaidAt         DateTime?
  payoutReference     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rider               Rider?               @relation(fields: [riderId], references: [id], onDelete: SetNull)
  otp                 OTP?
  order               Order?
  statusLogs          DeliveryStatusLog[]

  @@map("deliveries")
}

model DeliveryStatusLog {
  id          String         @id @default(uuid())
  deliveryId  String
  status      DeliveryStatus
  updatedBy   String
  notes       String?
  createdAt   DateTime       @default(now())

  delivery    Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@map("delivery_status_logs")
}

model OTP {
  id          String    @id @default(uuid())
  deliveryId  String    @unique
  otpCode     String
  isVerified  Boolean   @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  delivery    Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@map("otps")
}

model Notification {
  id         String   @id @default(uuid())
  userRole   Role
  customerId String?
  riderId    String?
  adminId    String?
  title      String
  message    String
  isRead     Boolean  @default(false)
  metadata   Json?
  createdAt  DateTime @default(now())

  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rider      Rider?    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  admin      Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model PhoneVerification {
  id          String   @id @default(uuid())
  phoneNumber String
  code        String
  isVerified  Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@map("phone_verifications")
}

enum PromotionType {
  PROMO_CODE
  FREE_DELIVERY
  PARTNER_DISCOUNT
  PLATFORM_AUTOMATIC
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Promotion {
  id               String        @id @default(uuid())
  code             String        @unique
  title            String
  description      String?       @db.Text
  promotionType    PromotionType @default(PROMO_CODE)
  discountType     DiscountType  @default(PERCENTAGE)
  discountValue    Float
  maxDiscount      Float?
  minOrderAmount   Float         @default(0.0)
  totalUsageLimit  Int?
  usedCount        Int           @default(0)
  perUserLimit     Int           @default(1)
  startDate        DateTime      @default(now())
  endDate          DateTime?
  isActive         Boolean       @default(true)
  applicableType   String        @default("ALL") // ALL, FOOD_ONLY, PACKAGE_ONLY, PARTNER_ONLY
  fundedBy         String        @default("PLATFORM") // PLATFORM, RESTAURANT, SPLIT_50_50
  restaurantId     String?
  restaurant       Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  redemptions      PromotionRedemption[]

  @@map("promotions")
}

model PromotionRedemption {
  id              String    @id @default(uuid())
  promotionId     String
  customerId      String
  orderId         String?
  discountApplied Float
  createdAt       DateTime  @default(now())

  promotion       Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@map("promotion_redemptions")
}
